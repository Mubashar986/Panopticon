# ==============================================================================
# PANOPTICON OBSERVATORY — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# Developers can adjust LLM models, retrieval depth, token budgets, and sync intervals
# directly in this file without modifying Python source code.
#
# Rule: Never commit your real API keys or sensitive credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE DRIVE AUTHENTICATION STRATEGY
# ------------------------------------------------------------------------------
# DRIVE_AUTH_MODE: Authentication strategy used to connect to Google Drive.
#   - 'oauth'           : Personal account local development using OAuth 2.0 (Installed Desktop App).
#   - 'service_account' : Enterprise Google Workspace Domain-Wide Delegation (DWD).
DRIVE_AUTH_MODE=oauth

# GOOGLE_CLIENT_SECRETS_FILE: Path to your Google Cloud OAuth 2.0 Client ID JSON file.
#   - Required when DRIVE_AUTH_MODE=oauth.
#   - Obtain from: Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth Client ID (Desktop App).
GOOGLE_CLIENT_SECRETS_FILE=credentials.json

# GOOGLE_TOKEN_CACHE_FILE: Path where user OAuth refresh and access tokens are securely cached.
GOOGLE_TOKEN_CACHE_FILE=token.json

# GOOGLE_SERVICE_ACCOUNT_FILE: Path to Google Service Account JSON key file.
#   - Required when DRIVE_AUTH_MODE=service_account.
#   - Obtain from: Google Cloud Console -> IAM & Admin -> Service Accounts -> Keys.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# GOOGLE_DELEGATED_USER_EMAIL: Email address of the Workspace user to impersonate.
#   - Required when DRIVE_AUTH_MODE=service_account for domain-wide delegation.
GOOGLE_DELEGATED_USER_EMAIL=user@company.com

# ------------------------------------------------------------------------------
# 2. MEILISEARCH LOCAL SEARCH ENGINE
# ------------------------------------------------------------------------------
# MEILI_HOST: HTTP endpoint of the local Meilisearch search instance.
#   - Note: Panopticon automatically downloads and launches the local binary if not running.
MEILI_HOST=http://localhost:7700

# MEILI_MASTER_KEY: Secret master key used to authenticate with Meilisearch.
#   - Must match the key used when booting the Meilisearch binary.
MEILI_MASTER_KEY=masterKey_panopticon_local_dev

# MEILI_INDEX_NAME: The primary search index name where document records are stored.
MEILI_INDEX_NAME=panopticon_docs

# MEILI_NO_ANALYTICS: Disables telemetry/analytics sent to Meilisearch (Recommended for privacy).
MEILI_NO_ANALYTICS=true

# ------------------------------------------------------------------------------
# 3. FASTAPI BACKEND SERVER & AUTO-SYNC SCHEDULER
# ------------------------------------------------------------------------------
# API_HOST: Bind IP address for the FastAPI backend server (127.0.0.1 for local only).
API_HOST=127.0.0.1

# API_PORT: Port number for the FastAPI backend server (Default: 8000).
API_PORT=8000

# CRAWL_DB_PATH: Path to the local SQLite database file with WAL mode enabled.
#   - Stores crawl state, version history, unified diffs, and thread messages.
CRAWL_DB_PATH=data/crawl_state.db

# AUTO_SYNC_ENABLED: Enables background periodic incremental sync with Google Drive.
#   - Set to 'true' to poll for Drive changes automatically; 'false' to sync only on-demand.
AUTO_SYNC_ENABLED=true

# AUTO_SYNC_INTERVAL_SECONDS: Number of seconds between background incremental sync polls.
#   - Recommended: 30 to 60 seconds for active development.
AUTO_SYNC_INTERVAL_SECONDS=30

# ------------------------------------------------------------------------------
# 4. LLM GATEWAY, BYOK (BRING YOUR OWN KEY) & MODEL CONFIGURATION
# ------------------------------------------------------------------------------
# OPENROUTER_API_KEY: Your LLM API key (e.g., OpenRouter, OpenAI, Groq).
#   - Leave blank if you are using a local offline LLM gateway (Ollama, LM Studio, vLLM).
#   - Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OPENROUTER_MODEL: The default active model slug for reasoning and change summaries.
#   - Examples:
#     - 'nvidia/nemotron-3.5-lightning:free'  (Fast, free reasoning model)
#     - 'anthropic/claude-3.7-sonnet'         (Top tier reasoning)
#     - 'openai/gpt-4o'                       (Fast, balanced)
#     - 'llama3.2:latest'                     (If using local Ollama)
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# OPENROUTER_BASE_URL: OpenAI-compatible API gateway URL.
#   - OpenRouter Cloud: https://openrouter.ai/api/v1
#   - Local Ollama:     http://localhost:11434/v1
#   - Local LM Studio:  http://localhost:1234/v1
#   - Groq Cloud:       https://api.groq.com/openai/v1
#   - OpenAI Direct:    https://api.openai.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM_DEFAULT_MODELS: Comma-separated list of active free models shown in the UI dropdown.
# Reference Catalog of Free Models on OpenRouter:
#   - OpenRouter Auto Free Router : openrouter/free                      (OpenRouter, Context: Dynamic)
#   - MiniMax M3                  : minimax/minimax-m3:free              (MiniMax, Context: 1.05M)
#   - Nemotron 3 Ultra            : nvidia/nemotron-3-ultra:free         (NVIDIA, Context: 1M)
#   - Laguna S 2.1                : poolside/laguna-s-2.1:free           (Poolside, Context: 262K)
#   - Nemotron 3.5 Lightning      : nvidia/nemotron-3.5-lightning:free   (NVIDIA, Context: 1M)
#   - Ling 3.0 Flash Fin          : inclusionai/ling-3.0-flash-fin:free  (InclusionAI, Context: 262K)
#   - MiniMax M2.7                : minimax/minimax-m2.7:free            (MiniMax, Context: 197K)
#   - Nemotron 3 Super            : nvidia/nemotron-3-super:free         (NVIDIA, Context: 262K)
#   - Inkling                     : thinkingmachines/inkling:free        (Thinking Machines, Context: 1.05M)
#   - Dots3-Note Preview          : dots-studio/dots3-note-preview:free  (Dots Studio, Context: 512K)
#   - Laguna XS 2.1               : poolside/laguna-xs-2.1:free          (Poolside, Context: 262K)
#   - North Mini Code             : cohere/north-mini-code:free          (Cohere, Context: 256K)
#   - Inkling Small               : thinkingmachines/inkling-small:free  (Thinking Machines, Context: 1.05M)
#   - Nemotron 3 Nano Omni        : nvidia/nemotron-3-nano-omni:free     (NVIDIA, Context: 256K)
#   - GLM 5.2                     : z-ai/glm-5.2:free                    (Z.ai, Context: 256K)
#   - LFM2.5-2.6B                 : liquid/lfm2.5-2.6b:free              (LiquidAI, Context: 66K)
LLM_DEFAULT_MODELS=openrouter/free,minimax/minimax-m3:free,nvidia/nemotron-3-ultra:free,poolside/laguna-s-2.1:free,nvidia/nemotron-3.5-lightning:free,inclusionai/ling-3.0-flash-fin:free,minimax/minimax-m2.7:free,nvidia/nemotron-3-super:free,thinkingmachines/inkling:free,dots-studio/dots3-note-preview:free,poolside/laguna-xs-2.1:free,cohere/north-mini-code:free,thinkingmachines/inkling-small:free,nvidia/nemotron-3-nano-omni:free,z-ai/glm-5.2:free,liquid/lfm2.5-2.6b:free

# LLM_MODEL_DISCOVERY_TIMEOUT_SECONDS: Timeout (seconds) when dynamically probing GET /v1/models.
LLM_MODEL_DISCOVERY_TIMEOUT_SECONDS=10.0

# LLM_MAX_OUTPUT_TOKENS: Maximum number of tokens generated per completion before length cutoff.
#   - Higher values allow longer, more detailed responses (e.g. 2000-4000).
LLM_MAX_OUTPUT_TOKENS=2000

# LLM_TEMPERATURE: Sampling temperature for model responses (0.0 to 1.0).
#   - 0.0 to 0.2: Highly factual, deterministic (Recommended for Q&A and diff analysis).
#   - 0.7 to 1.0: More creative, varied.
LLM_TEMPERATURE=0.1

# LLM_STREAM_CHUNK_BATCH_SIZE: Number of words batched before emitting an SSE token frame.
#   - Lower values (2-4) provide smoother real-time streaming to the React drawer.
LLM_STREAM_CHUNK_BATCH_SIZE=4

# ------------------------------------------------------------------------------
# 5. AGENT REASONING & RETRIEVAL DEPTH TUNING
# ------------------------------------------------------------------------------
# AGENT_MAX_REASONING_STEPS: Maximum ReAct tool-execution turns before forcing answer synthesis.
#   - Prevents infinite tool-calling loops while giving the agent enough turns to research.
#   - Recommended: 5 to 8 turns.
AGENT_MAX_REASONING_STEPS=5

# AGENT_MAX_TOOL_OUTPUT_CHARS: Maximum characters allowed in a single tool output payload.
#   - If a tool output exceeds this size, it is safely truncated with a context limit notice.
#   - Protects LLM context window from being overwhelmed by massive documents.
AGENT_MAX_TOOL_OUTPUT_CHARS=4000

# AGENT_DEFAULT_SEARCH_LIMIT: Default number of search hits returned by 'search_index' tool.
AGENT_DEFAULT_SEARCH_LIMIT=5

# AGENT_MAX_SEARCH_LIMIT: Hard upper limit of search hits allowed by 'search_index' tool.
AGENT_MAX_SEARCH_LIMIT=15

# AGENT_MAX_CHUNKS_LIMIT: Maximum number of semantic vector chunks returned by 'semantic_chunk_search'.
#   - Controls how many paragraph-level excerpts the agent receives for semantic queries.
AGENT_MAX_CHUNKS_LIMIT=8

# AGENT_CHUNK_SNIPPET_CHARS: Character length of each chunk text preview passed to the LLM prompt.
#   - 1200 characters is approximately 200-250 words per chunk.
AGENT_CHUNK_SNIPPET_CHARS=1200

# AGENT_DIFF_SNIPPET_CHARS: Character length of unified diff patch text passed to the LLM prompt.
#   - Allows the agent to inspect additions/deletions in version history.
AGENT_DIFF_SNIPPET_CHARS=2500

# ------------------------------------------------------------------------------
# 6. INGESTION, CHUNKING & DOCUMENT EXPORT SETTINGS
# ------------------------------------------------------------------------------
# CHUNK_SIZE: Target maximum character length for sliding-window document chunking.
#   - Documents are split on natural paragraph boundaries into ~1500 character units.
CHUNK_SIZE=1500

# CHUNK_OVERLAP: Number of characters from the previous chunk preserved at the start of the next chunk.
#   - Ensures semantic continuity across paragraph boundaries. Must be strictly less than CHUNK_SIZE.
CHUNK_OVERLAP=200

# EXPORT_MAX_SNIPPET_CHARS: Maximum characters extracted for the search preview snippet.
#   - Stored in Meilisearch for fast keyword matching and search result cards.
EXPORT_MAX_SNIPPET_CHARS=500

# EXPORT_MAX_BYTES: Circuit breaker byte ceiling for exporting Google Docs and Sheets.
#   - Google Drive server-side conversion fails above 10MB (10485760 bytes).
#   - Files larger than this fallback gracefully to metadata-only indexing without crashing.
EXPORT_MAX_BYTES=10485760

# ------------------------------------------------------------------------------
# 7. VECTOR EMBEDDINGS & WATERMARK SAFETY TIMING
# ------------------------------------------------------------------------------
# EMBEDDING_MODEL: Model identifier used to generate dense vector representations for chunks.
#   - Default: 'text-embedding-3-small' (1536 dimensions).
EMBEDDING_MODEL=text-embedding-3-small

# EMBEDDING_DIMENSION: Vector dimension for the chosen embedding model.
#   - Must match the output dimension of EMBEDDING_MODEL (e.g. 1536 for text-embedding-3-small, 768 or 384 for local models).
EMBEDDING_DIMENSION=1536

# SYNC_WATERMARK_BUFFER_SECONDS: Overlap safety window (seconds) applied during incremental sync.
#   - Compensates for Google Drive eventual consistency latency so rapid edits are never orphaned.
#   - Default: 120 seconds.
SYNC_WATERMARK_BUFFER_SECONDS=120
