# ==============================================================================
# Panopticon Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Drive Authentication Strategy
# ------------------------------------------------------------------------------
# Choose 'oauth' for personal account local development (Installed App flow)
# Choose 'service_account' for Google Workspace Domain-Wide Delegation
DRIVE_AUTH_MODE=oauth

# Personal OAuth Configuration (Used when DRIVE_AUTH_MODE=oauth)
# Obtain OAuth Client ID JSON from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
GOOGLE_TOKEN_CACHE_FILE=token.json

# Service Account / Domain-Wide Delegation (Used when DRIVE_AUTH_MODE=service_account)
# Obtain Service Account key from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# The email address of the Workspace user to impersonate via domain-wide delegation:
GOOGLE_DELEGATED_USER_EMAIL=user@company.com

# ------------------------------------------------------------------------------
# Meilisearch Configuration
# ------------------------------------------------------------------------------
# Local instance running via binary or Docker
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey_panopticon_local_dev
MEILI_INDEX_NAME=panopticon_docs
# Disable anonymous telemetry / analytics (Recommended for privacy & compliance)
MEILI_NO_ANALYTICS=true

# ------------------------------------------------------------------------------
# FastAPI Backend & Crawler Configuration
# ------------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CRAWL_DB_PATH=data/crawl_state.db
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_SECONDS=30

# ------------------------------------------------------------------------------
# OpenRouter AI Semantic Change Summarizer & Agentic RAG
# ------------------------------------------------------------------------------
# Obtain API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model slug to use for change summaries (e.g. thinkingmachines/inkling:free, openai/gpt-4o-mini)
OPENROUTER_MODEL=thinkingmachines/inkling:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
