{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Panopticon Design System Tokens",
  "version": "1.0.0",
  "colors": {
    "background": {
      "canvas": "#090514",
      "surface": "#150E24",
      "surfaceElevated": "#1E1B3A"
    },
    "text": {
      "primary": "#F1F5F9",
      "secondary": "#94A3B8"
    },
    "brand": {
      "primary": "#8B5CF6",
      "primaryHover": "#A78BFA",
      "tagMatch": "#A855F7",
      "drive": "#4285F4"
    },
    "border": {
      "subtle": "#2E2A4A"
    },
    "status": {
      "success": "#10B981",
      "warning": "#F59E0B",
      "error": "#F43F5E"
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "xl": "20px",
    "full": "9999px"
  },
  "elevation": {
    "glowPrimary": "0 0 20px -5px rgba(139, 92, 246, 0.5)",
    "cardHover": "0 10px 30px -10px rgba(0, 0, 0, 0.5)"
  },
  "motion": {
    "durationBase": "250ms"
  }
}
