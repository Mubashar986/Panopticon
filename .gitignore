# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Linters
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local Persistence / Database
*.sqlite
*.sqlite3
*.db
data/
crawl_cache/

# ------------------------------------------------------------------------------
# Meilisearch Local Data
# ------------------------------------------------------------------------------
data.ms/
meili_data/

