.agents/
AGENTS.md
GEMINI.md

# ------------------------------------------------------------------------------
# Google API Credentials, OAuth Tokens & Secrets (STRICT - NO COMMITS)
# ------------------------------------------------------------------------------
credentials.json
token.json
token.pickle
service_account.json
*.pem
*.key
*.p12

# Environment files (keep .env.example tracked)
.env
.env.local
.env.*.local
!.env.example

# ------------------------------------------------------------------------------
